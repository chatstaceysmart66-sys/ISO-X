label live-@FLAVOUR@
	menu label ^Live system (@FLAVOUR@)
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-persistence
	menu label Live system (@FLAVOUR@) with Persistence
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ persistence

label live-@FLAVOUR@-failsafe
	menu label Live system (@FLAVOUR@ fail-safe mode)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@
