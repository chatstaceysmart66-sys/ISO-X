#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

fatal() {
    echo
    echo "============================================================"
    echo " ISO-X INTEGRITY CHECK FAILED"
    echo " Required watermark module is missing, changed, unsigned, or invalid."
    echo " ISO-X will not continue to its desktop session."
    echo " Use trusted recovery media; do not delete the module to bypass attribution."
    echo "============================================================"
    echo
    # Fail closed for the Live ISO but leave an interactive rescue shell.
    /bin/sh -i </dev/console >/dev/console 2>&1 || true
    echo "ISO-X remains stopped. Reboot after using trusted recovery media." >/dev/console
    while :; do sleep 3600; done
}

[ -r /etc/isox/watermark-policy ] || fatal
[ -r /etc/isox/watermark-public.pem ] || fatal
[ -r /etc/isox/isox_watermark.ko.sig ] || fatal
[ -r /etc/isox/isox_watermark.sha256 ] || fatal
MODULE_PATH=$(find /lib/modules -type f -name 'isox_watermark.ko' 2>/dev/null | head -n 1)
[ -n "$MODULE_PATH" ] && [ -s "$MODULE_PATH" ] || fatal
cd / || fatal
if ! openssl dgst -sha256 -verify /etc/isox/watermark-public.pem \
    -signature /etc/isox/isox_watermark.ko.sig "$MODULE_PATH" >/dev/null 2>&1; then
    fatal
fi
if ! sha256sum -c /etc/isox/isox_watermark.sha256 >/dev/null 2>&1; then
    fatal
fi
if ! modprobe isox_watermark 2>/dev/null; then
    # With Secure Boot / strict module enforcement the release cert must be trusted by the kernel.
    fatal
fi
# Successful modprobe runs the module init function. Check sysfs rather than
# parsing dmesg, which may be restricted under kernel lockdown.
[ -d /sys/module/isox_watermark ] || fatal
exit 0
